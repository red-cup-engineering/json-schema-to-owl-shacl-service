{
  "name": "@red-cup-engineering/json-schema-to-owl-shacl-service",
  "version": "0.1.0",
  "description": "Mechanically derives an OWL class model and SHACL validation shapes from a set of JSON Schema (draft 2020-12) files, so the schema stays the one authored source and its RDF projection is generated, never hand-duplicated.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/json-schema-to-owl-shacl-service.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/json-schema-to-ontology.mjs",
    "./turtle": "./src/named-graph-as-prefixed-turtle.mjs"
  },
  "bin": {
    "project-json-schema-as-ontology": "scripts/project-json-schema-set-as-ontology.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@red-cup-engineering/computer-triplet-serialized-content-engineering-services-section": "0.1.1",
    "@red-cup-engineering/turtle-engineering-services-section": "0.1.2"
  },
  "private": false,
  "files": [
    "package.json",
    "README*",
    "LICENSE*",
    "scripts",
    "src"
  ],
  "license": "MIT",
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}
